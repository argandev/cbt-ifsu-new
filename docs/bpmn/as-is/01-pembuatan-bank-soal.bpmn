<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proses_PembuatanBankSoal_AsIs" targetNamespace="http://cbt-smk-v2/bpmn/as-is" exporter="CBT SMK v2 - Tim BPMN As-Is" exporterVersion="1.0 (2026-10-17)">
  <bpmn:collaboration id="Collaboration_Proses_PembuatanBankSoal_AsIs" name="Proses Pembuatan Bank Soal — Manual">
    <bpmn:participant id="Participant_Proses_PembuatanBankSoal_AsIs" name="Proses Pembuatan Bank Soal — Manual" processRef="Proses_PembuatanBankSoal_AsIs"/>
  </bpmn:collaboration>
  <bpmn:process id="Proses_PembuatanBankSoal_AsIs" name="Pembuatan Bank Soal (As-Is, Manual)" isExecutable="false">
    <bpmn:documentation>Alur as-is (sebelum aplikasi CBT SMK v2): guru menyusun soal ujian di Microsoft Word, mencetak naskah induk, memfotokopi, dan menyimpan naskah di map/lemari terkunci. Asumsi: satu guru mengampu satu mata pelajaran; naskah bersifat rahasia sebelum ujian; tidak ada bank soal digital terpusat; verifikasi dilakukan manual oleh Wakakurikulum/Kaprodi; kisi-kisi mengacu pada kurikulum dan TP (tujuan pembelajaran) yang berlaku; STS/SAS/USBK mengikuti pola ujian sekolah konvensional Indonesia.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Proses_PembuatanBankSoal_AsIs" name="Aktor">
      <bpmn:lane id="Lane_Proses_PembuatanBankSoal_AsIs_0" name="Guru Mata Pelajaran">
        <bpmn:flowNodeRef>Start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_PembuatanBankSoal_AsIs_1" name="Wakakurikulum / Ketua Program">
        <bpmn:flowNodeRef>T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_PembuatanBankSoal_AsIs_2" name="Panitia Ujian">
        <bpmn:flowNodeRef>T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start1" name="Mulai">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T01" name="Tentukan Kisi-Kisi dan Materi">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T02" name="Susun Soal di Word">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T03" name="Susun Kunci Jawaban">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T04" name="Periksa Soal Sendiri">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G01" name="Soal sudah sesuai kisi-kisi?">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T05" name="Revisi Soal">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T06" name="Serahkan Naskah ke Wakakurikulum">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T07" name="Verifikasi Naskah Soal">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G02" name="Naskah lolos verifikasi?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T08" name="Perbaiki Naskah Soal">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T09" name="Cetak Naskah Induk">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T10" name="Fotokopi Naskah Ujian">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T11" name="Simpan Naskah di Map/Lemari Terkunci">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End1" name="Selesai">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start1" targetRef="T01"/>
    <bpmn:sequenceFlow id="F02" sourceRef="T01" targetRef="T02"/>
    <bpmn:sequenceFlow id="F03" sourceRef="T02" targetRef="T03"/>
    <bpmn:sequenceFlow id="F04" sourceRef="T03" targetRef="T04"/>
    <bpmn:sequenceFlow id="F05" sourceRef="T04" targetRef="G01"/>
    <bpmn:sequenceFlow id="F06" sourceRef="G01" targetRef="T05" name="Tidak"/>
    <bpmn:sequenceFlow id="F07" sourceRef="T05" targetRef="T02" name="Hasil revisi diperiksa ulang"/>
    <bpmn:sequenceFlow id="F08" sourceRef="G01" targetRef="T06" name="Ya"/>
    <bpmn:sequenceFlow id="F09" sourceRef="T06" targetRef="T07"/>
    <bpmn:sequenceFlow id="F10" sourceRef="T07" targetRef="G02"/>
    <bpmn:sequenceFlow id="F11" sourceRef="G02" targetRef="T08" name="Tidak"/>
    <bpmn:sequenceFlow id="F12" sourceRef="T08" targetRef="T02" name="Naskah diperbaiki lalu disusun ulang"/>
    <bpmn:sequenceFlow id="F13" sourceRef="G02" targetRef="T09" name="Ya"/>
    <bpmn:sequenceFlow id="F14" sourceRef="T09" targetRef="T10"/>
    <bpmn:sequenceFlow id="F15" sourceRef="T10" targetRef="T11"/>
    <bpmn:sequenceFlow id="F16" sourceRef="T11" targetRef="End1"/>
  </bpmn:process>
