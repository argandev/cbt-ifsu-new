<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proses_PelaksanaanUjianSiswa_AsIs" targetNamespace="http://cbt-smk-v2/bpmn/as-is" exporter="CBT SMK v2 - Tim BPMN As-Is" exporterVersion="1.0 (2026-10-17)">
  <bpmn:collaboration id="Collaboration_Proses_PelaksanaanUjianSiswa_AsIs" name="Proses Pelaksanaan Ujian Siswa — Manual (Kertas)">
    <bpmn:participant id="Participant_Proses_PelaksanaanUjianSiswa_AsIs" name="Proses Pelaksanaan Ujian Siswa — Manual (Kertas)" processRef="Proses_PelaksanaanUjianSiswa_AsIs"/>
  </bpmn:collaboration>
  <bpmn:process id="Proses_PelaksanaanUjianSiswa_AsIs" name="Pelaksanaan Ujian Siswa (As-Is, Manual)" isExecutable="false">
    <bpmn:documentation>Alur as-is: siswa mengerjakan ujian di atas kertas dengan naskah soal dan Lembar Jawaban Kertas (LJK), absensi manual di daftar hadir kertas, pengawasan manual oleh pengawas ruangan. Asumsi: siswa membawa kartu peserta/kartu pelajar; siswa yang terlambat melewati batas toleransi sekolah tidak diizinkan masuk (kebijakan sekolah); tidak ada timer digital, token, atau penguncian perangkat; pelanggaran dicatat di berita acara.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Proses_PelaksanaanUjianSiswa_AsIs" name="Aktor">
      <bpmn:lane id="Lane_Proses_PelaksanaanUjianSiswa_AsIs_0" name="Siswa">
        <bpmn:flowNodeRef>Start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_PelaksanaanUjianSiswa_AsIs_1" name="Pengawas Ujian">
        <bpmn:flowNodeRef>T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_PelaksanaanUjianSiswa_AsIs_2" name="Panitia Ujian">
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start1" name="Mulai">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T01" name="Masuk Ruangan Ujian">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T02" name="Periksa Kehadiran Siswa">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G01" name="Siswa terdaftar di daftar hadir?">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T03" name="Catat Siswa Tidak Hadir">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End2" name="Selesai — Siswa Tidak Hadir">
      <bpmn:incoming>F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T04" name="Bagikan Naskah dan LJK">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T05" name="Isi Identitas di LJK">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T06" name="Kerjakan Soal di Kertas">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T07" name="Awasi Ujian di Ruangan">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G02" name="Ada pelanggaran tata tertib?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T08" name="Catat Pelanggaran di Berita Acara">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T09" name="Kumpulkan Naskah dan LJK">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T10" name="Hitung dan Periksa Kelengkapan Naskah">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G03" name="Naskah lengkap sesuai jumlah hadir?">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T11" name="Cari Naskah yang Hilang">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T12" name="Serahkan Naskah ke Panitia">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T13" name="Simpan Naskah Hasil Ujian">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End1" name="Selesai">
      <bpmn:incoming>F20</bpmn:incoming>
    </bpmn:endEvent>
