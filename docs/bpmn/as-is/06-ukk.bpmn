<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proses_UKK_AsIs" targetNamespace="http://cbt-smk-v2/bpmn/as-is" exporter="CBT SMK v2 - Tim BPMN As-Is" exporterVersion="1.0 (2026-10-17)">
  <bpmn:collaboration id="Collaboration_Proses_UKK_AsIs" name="Proses Uji Kompetensi Keahlian (UKK) — Manual">
    <bpmn:participant id="Participant_Proses_UKK_AsIs" name="Proses Uji Kompetensi Keahlian (UKK) — Manual" processRef="Proses_UKK_AsIs"/>
  </bpmn:collaboration>
  <bpmn:process id="Proses_UKK_AsIs" name="Uji Kompetensi Keahlian / UKK (As-Is, Manual)" isExecutable="false">
    <bpmn:documentation>Alur as-is: UKK dilaksanakan manual dengan penguji internal sekolah dan penguji eksternal dari DUDIKA (Dunia Usaha, Dunia Industri, dan Dunia Kerja). Nilai teori dan praktik dicatat di kertas/formulir penilaian, nilai akhir dihitung manual (teori 40% + praktik 60%), sertifikat dibuat manual. Asumsi: mengacu pada pedoman UKK SMK; rubrik praktik mencakup proses, produk, dan sikap; kelulusan minimal 70 sesuai ketentuan sekolah; tidak ada modul UKK digital, kartu peserta digital, atau sertifikat otomatis.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Proses_UKK_AsIs" name="Aktor">
      <bpmn:lane id="Lane_Proses_UKK_AsIs_0" name="Panitia UKK">
        <bpmn:flowNodeRef>Start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_UKK_AsIs_1" name="Siswa">
        <bpmn:flowNodeRef>T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_UKK_AsIs_2" name="Penguji Internal">
        <bpmn:flowNodeRef>T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_UKK_AsIs_3" name="Penguji Eksternal (DUDIKA)">
        <bpmn:flowNodeRef>T07</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start1" name="Mulai">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T01" name="Siapkan Jadwal dan Tempat UKK">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T02" name="Undang Penguji Eksternal DUDIKA">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T03" name="Daftar sebagai Peserta UKK">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T04" name="Ikuti Ujian Teori (Kertas)">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T05" name="Ikuti Ujian Praktik">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T06" name="Nilai Ujian Teori">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T07" name="Nilai Ujian Praktik dengan Rubrik">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T08" name="Hitung Nilai Akhir UKK">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G01" name="Nilai akhir lulus (&gt;= 70)?">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T09" name="Catat Peserta Lulus">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T10" name="Catat Peserta Tidak Lulus">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T11" name="Buat Sertifikat Manual">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T12" name="Serahkan Sertifikat ke Siswa">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T13" name="Arsipkan Nilai UKK">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End1" name="Selesai">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start1" targetRef="T01"/>
    <bpmn:sequenceFlow id="F02" sourceRef="T01" targetRef="T02"/>
    <bpmn:sequenceFlow id="F03" sourceRef="T02" targetRef="T03"/>
    <bpmn:sequenceFlow id="F04" sourceRef="T03" targetRef="T04"/>
    <bpmn:sequenceFlow id="F05" sourceRef="T04" targetRef="T05"/>
    <bpmn:sequenceFlow id="F06" sourceRef="T05" targetRef="T06"/>
    <bpmn:sequenceFlow id="F07" sourceRef="T06" targetRef="T07"/>
    <bpmn:sequenceFlow id="F08" sourceRef="T07" targetRef="T08"/>
    <bpmn:sequenceFlow id="F09" sourceRef="T08" targetRef="G01"/>
    <bpmn:sequenceFlow id="F10" sourceRef="G01" targetRef="T09" name="Ya"/>
    <bpmn:sequenceFlow id="F11" sourceRef="G01" targetRef="T10" name="Tidak"/>
    <bpmn:sequenceFlow id="F12" sourceRef="T09" targetRef="T11"/>
    <bpmn:sequenceFlow id="F13" sourceRef="T10" targetRef="T11"/>
    <bpmn:sequenceFlow id="F14" sourceRef="T11" targetRef="T12"/>
    <bpmn:sequenceFlow id="F15" sourceRef="T12" targetRef="T13"/>
    <bpmn:sequenceFlow id="F16" sourceRef="T13" targetRef="End1"/>
  </bpmn:process>
