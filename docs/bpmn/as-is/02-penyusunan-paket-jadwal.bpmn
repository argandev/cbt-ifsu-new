    <bpmn:sequenceFlow id="F06" sourceRef="G01" targetRef="T05" name="Tidak"/>
    <bpmn:sequenceFlow id="F07" sourceRef="T05" targetRef="T02" name="Jadwal disusun ulang"/>
    <bpmn:sequenceFlow id="F08" sourceRef="G01" targetRef="T06" name="Ya"/>
    <bpmn:sequenceFlow id="F09" sourceRef="T06" targetRef="T07"/>
    <bpmn:sequenceFlow id="F10" sourceRef="T07" targetRef="G02"/>
    <bpmn:sequenceFlow id="F11" sourceRef="G02" targetRef="T08" name="Tidak"/>
    <bpmn:sequenceFlow id="F12" sourceRef="T08" targetRef="T02" name="Jadwal direvisi lalu diperiksa ulang"/>
