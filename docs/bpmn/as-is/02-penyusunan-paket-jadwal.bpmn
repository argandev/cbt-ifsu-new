<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proses_PenyusunanPaketJadwal_AsIs" targetNamespace="http://cbt-smk-v2/bpmn/as-is" exporter="CBT SMK v2 - Tim BPMN As-Is" exporterVersion="1.0 (2026-10-17)">
  <bpmn:collaboration id="Collaboration_Proses_PenyusunanPaketJadwal_AsIs" name="Proses Penyusunan Paket dan Jadwal Ujian — Manual">
    <bpmn:participant id="Participant_Proses_PenyusunanPaketJadwal_AsIs" name="Proses Penyusunan Paket dan Jadwal Ujian — Manual" processRef="Proses_PenyusunanPaketJadwal_AsIs"/>
  </bpmn:collaboration>
  <bpmn:process id="Proses_PenyusunanPaketJadwal_AsIs" name="Penyusunan Paket dan Jadwal Ujian (As-Is, Manual)" isExecutable="false">
    <bpmn:documentation>Alur as-is: panitia menyusun jadwal ujian (STS/SAS/USBK) di kertas/papan pengumuman, membagi ruangan dan pengawas, serta menyiapkan distribusi naskah. Asumsi: jadwal disusun per semester; satu ruangan satu mata pelajaran per sesi; pengawas bukan guru pengampu mata pelajaran yang diujikan; naskah didistribusikan dalam amplop tertutup; tidak ada token, sesi digital, atau jadwal di aplikasi.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Proses_PenyusunanPaketJadwal_AsIs" name="Aktor">
      <bpmn:lane id="Lane_Proses_PenyusunanPaketJadwal_AsIs_0" name="Panitia Ujian / Proktor">
        <bpmn:flowNodeRef>Start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_PenyusunanPaketJadwal_AsIs_1" name="Wakakurikulum">
        <bpmn:flowNodeRef>T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_PenyusunanPaketJadwal_AsIs_2" name="Kepala Sekolah">
        <bpmn:flowNodeRef>T09</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start1" name="Mulai">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T01" name="Kumpulkan Data Kelas dan Mata Pelajaran">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T02" name="Susun Draf Jadwal Ujian">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T03" name="Tentukan Pembagian Ruangan">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T04" name="Tentukan Pengawas Ujian">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G01" name="Ruangan dan pengawas mencukupi?">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T05" name="Sesuaikan Jadwal dan Ruangan">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T06" name="Ajukan Jadwal ke Wakakurikulum">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T07" name="Periksa Jadwal Ujian">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G02" name="Jadwal disetujui?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T08" name="Revisi Jadwal Ujian">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T09" name="Sahkan Jadwal Ujian">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T10" name="Umumkan Jadwal di Papan Pengumuman">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T11" name="Siapkan Naskah per Ruangan">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T12" name="Serahkan Naskah ke Pengawas">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End1" name="Selesai">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start1" targetRef="T01"/>
    <bpmn:sequenceFlow id="F02" sourceRef="T01" targetRef="T02"/>
    <bpmn:sequenceFlow id="F03" sourceRef="T02" targetRef="T03"/>
    <bpmn:sequenceFlow id="F04" sourceRef="T03" targetRef="T04"/>
