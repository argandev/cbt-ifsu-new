<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proses_ImportSoal_AsIs" targetNamespace="http://cbt-smk-v2/bpmn/as-is" exporter="CBT SMK v2 - Tim BPMN As-Is" exporterVersion="1.0 (2026-10-17)">
  <bpmn:collaboration id="Collaboration_Proses_ImportSoal_AsIs" name="Proses Penyalinan Soal dari Dokumen — Manual">
    <bpmn:participant id="Participant_Proses_ImportSoal_AsIs" name="Proses Penyalinan Soal dari Dokumen — Manual" processRef="Proses_ImportSoal_AsIs"/>
  </bpmn:collaboration>
  <bpmn:process id="Proses_ImportSoal_AsIs" name="Penyalinan Soal dari Dokumen (As-Is, Manual)" isExecutable="false">
    <bpmn:documentation>Alur as-is: tidak ada import otomatis. Guru menyalin/mengetik ulang soal dari dokumen Word/Excel sumber ke format naskah ujian, lalu memeriksa hasil salinan secara manual. Asumsi: dokumen sumber bisa berasal dari guru lain, buku, atau bank soal lama; penyalinan manual rawan salah ketik sehingga pemeriksaan ulang wajib; tidak ada template Excel/Word terstruktur, preview import, validasi otomatis, atau deteksi duplikat; format akhir adalah naskah kertas.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Proses_ImportSoal_AsIs" name="Aktor">
      <bpmn:lane id="Lane_Proses_ImportSoal_AsIs_0" name="Guru Mata Pelajaran">
        <bpmn:flowNodeRef>Start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_ImportSoal_AsIs_1" name="Panitia Ujian">
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start1" name="Mulai">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T01" name="Terima Dokumen Soal Word/Excel">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T02" name="Baca Dokumen Soal Sumber">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T03" name="Salin Soal ke Format Naskah (Ketik Ulang)">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T04" name="Salin Kunci Jawaban">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T05" name="Periksa Hasil Salinan">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G01" name="Ada kesalahan salin?">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T06" name="Perbaiki Hasil Salinan">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T07" name="Format Ulang Naskah Soal">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T08" name="Cetak Naskah Hasil Salinan">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T09" name="Serahkan Naskah ke Panitia">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T10" name="Terima dan Arsipkan Naskah">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End1" name="Selesai">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start1" targetRef="T01"/>
    <bpmn:sequenceFlow id="F02" sourceRef="T01" targetRef="T02"/>
    <bpmn:sequenceFlow id="F03" sourceRef="T02" targetRef="T03"/>
    <bpmn:sequenceFlow id="F04" sourceRef="T03" targetRef="T04"/>
    <bpmn:sequenceFlow id="F05" sourceRef="T04" targetRef="T05"/>
    <bpmn:sequenceFlow id="F06" sourceRef="T05" targetRef="G01"/>
    <bpmn:sequenceFlow id="F07" sourceRef="G01" targetRef="T06" name="Ya"/>
    <bpmn:sequenceFlow id="F08" sourceRef="T06" targetRef="T05" name="Hasil salinan diperiksa ulang"/>
    <bpmn:sequenceFlow id="F09" sourceRef="G01" targetRef="T07" name="Tidak"/>
    <bpmn:sequenceFlow id="F10" sourceRef="T07" targetRef="T08"/>
    <bpmn:sequenceFlow id="F11" sourceRef="T08" targetRef="T09"/>
    <bpmn:sequenceFlow id="F12" sourceRef="T09" targetRef="T10"/>
    <bpmn:sequenceFlow id="F13" sourceRef="T10" targetRef="End1"/>
  </bpmn:process>
