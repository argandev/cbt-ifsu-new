    <sequenceFlow id="f10" sourceRef="g_error" targetRef="t_perbaiki" name="Ya, ada error" />
    <sequenceFlow id="f11" sourceRef="t_perbaiki" targetRef="t_unggah" />
    <sequenceFlow id="f12" sourceRef="g_error" targetRef="t_simpan" name="Tidak ada error" />
    <sequenceFlow id="f13" sourceRef="t_simpan" targetRef="g_lagi" />
    <sequenceFlow id="f14" sourceRef="g_lagi" targetRef="g_cara" name="Ya, tambah lagi" />
    <sequenceFlow id="f15" sourceRef="g_lagi" targetRef="t_telaah" name="Tidak" />
    <sequenceFlow id="f16" sourceRef="t_telaah" targetRef="g_kunci" />
    <sequenceFlow id="f17" sourceRef="g_kunci" targetRef="g_cara" name="Belum siap, revisi soal" />
    <sequenceFlow id="f18" sourceRef="g_kunci" targetRef="t_ajukan" name="Siap dikunci" />
    <sequenceFlow id="f19" sourceRef="t_ajukan" targetRef="t_kunci_sys" />
    <sequenceFlow id="f20" sourceRef="t_kunci_sys" targetRef="end" />
  </process>
