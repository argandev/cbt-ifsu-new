        <flowNodeRef>t_pilih</flowNodeRef>
        <flowNodeRef>t_token</flowNodeRef>
        <flowNodeRef>g_coba</flowNodeRef>
        <flowNodeRef>end_ditolak</flowNodeRef>
        <flowNodeRef>end_telat</flowNodeRef>
        <flowNodeRef>t_kerjakan</flowNodeRef>
        <flowNodeRef>g_ragu</flowNodeRef>
        <flowNodeRef>end_block</flowNodeRef>
        <flowNodeRef>g_selesai</flowNodeRef>
        <flowNodeRef>t_submit</flowNodeRef>
        <flowNodeRef>end_ok</flowNodeRef>
      </lane>
      <lane id="lane_1" name="Sistem (CBT SMK v2)">
        <flowNodeRef>t_validasi</flowNodeRef>
        <flowNodeRef>g_token</flowNodeRef>
        <flowNodeRef>t_tolak</flowNodeRef>
        <flowNodeRef>t_telat</flowNodeRef>
        <flowNodeRef>g_telat</flowNodeRef>
        <flowNodeRef>t_mulai</flowNodeRef>
        <flowNodeRef>t_autosave</flowNodeRef>
        <flowNodeRef>t_ragu</flowNodeRef>
        <flowNodeRef>g_langgar</flowNodeRef>
        <flowNodeRef>g_hitung</flowNodeRef>
        <flowNodeRef>t_peringat</flowNodeRef>
        <flowNodeRef>t_block</flowNodeRef>
        <flowNodeRef>t_lanjut</flowNodeRef>
        <flowNodeRef>t_autosubmit</flowNodeRef>
        <flowNodeRef>t_kunci</flowNodeRef>
      </lane>
      <lane id="lane_2" name="Pengawas">
        <flowNodeRef>g_unblock</flowNodeRef>
        <flowNodeRef>t_usul</flowNodeRef>
      </lane>
      <lane id="lane_3" name="Proktor">
        <flowNodeRef>t_eksekusi</flowNodeRef>
      </lane>
    </laneSet>
