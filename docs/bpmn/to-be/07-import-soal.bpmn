    <sequenceFlow id="f06" sourceRef="g_format" targetRef="t_tolak" name="Tidak" />
    <sequenceFlow id="f07" sourceRef="t_tolak" targetRef="g_ulang" />
    <sequenceFlow id="f08" sourceRef="g_ulang" targetRef="t_isi" name="Ya" />
    <sequenceFlow id="f09" sourceRef="g_ulang" targetRef="end_batal" name="Tidak" />
    <sequenceFlow id="f10" sourceRef="g_format" targetRef="g_error" name="Ya" />
    <sequenceFlow id="f11" sourceRef="g_error" targetRef="t_perbaiki" name="Ya" />
    <sequenceFlow id="f12" sourceRef="t_perbaiki" targetRef="t_unggah" />
    <sequenceFlow id="f13" sourceRef="g_error" targetRef="t_mode" name="Tidak" />
    <sequenceFlow id="f14" sourceRef="t_mode" targetRef="t_duplikat" />
    <sequenceFlow id="f15" sourceRef="t_duplikat" targetRef="t_konfirm" />
    <sequenceFlow id="f16" sourceRef="t_konfirm" targetRef="t_simpan" />
    <sequenceFlow id="f17" sourceRef="t_simpan" targetRef="end" />
  </process>
