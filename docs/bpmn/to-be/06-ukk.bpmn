    <sequenceFlow id="f07" sourceRef="g_valid" targetRef="t_perbaiki" name="Tidak" />
    <sequenceFlow id="f08" sourceRef="t_perbaiki" targetRef="t_unggah" />
    <sequenceFlow id="f09" sourceRef="g_valid" targetRef="t_rubrik" name="Ya" />
    <sequenceFlow id="f10" sourceRef="t_rubrik" targetRef="t_hitung_p" />
    <sequenceFlow id="f11" sourceRef="t_hitung_p" targetRef="t_hitung_a" />
    <sequenceFlow id="f12" sourceRef="t_hitung_a" targetRef="g_lulus" />
    <sequenceFlow id="f13" sourceRef="g_lulus" targetRef="t_belum" name="Tidak" />
    <sequenceFlow id="f14" sourceRef="t_belum" targetRef="end_belum" />
    <sequenceFlow id="f15" sourceRef="g_lulus" targetRef="t_final" name="Ya" />
    <sequenceFlow id="f16" sourceRef="t_final" targetRef="t_sertifikat" />
    <sequenceFlow id="f17" sourceRef="t_sertifikat" targetRef="end_lulus" />
  </process>
