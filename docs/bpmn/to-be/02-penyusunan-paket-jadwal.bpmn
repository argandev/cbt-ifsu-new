    <sequenceFlow id="f07" sourceRef="t_susun" targetRef="t_durasi" />
    <sequenceFlow id="f08" sourceRef="t_durasi" targetRef="t_jadwal" />
    <sequenceFlow id="f09" sourceRef="t_jadwal" targetRef="t_token" />
    <sequenceFlow id="f10" sourceRef="t_token" targetRef="g_ulang" />
    <sequenceFlow id="f11" sourceRef="g_ulang" targetRef="t_hangus" name="Ya" />
    <sequenceFlow id="f12" sourceRef="t_hangus" targetRef="t_token" />
    <sequenceFlow id="f13" sourceRef="g_ulang" targetRef="t_umumkan" name="Tidak" />
    <sequenceFlow id="f14" sourceRef="t_umumkan" targetRef="g_pause" />
    <sequenceFlow id="f15" sourceRef="g_pause" targetRef="t_pause" name="Ya" />
    <sequenceFlow id="f16" sourceRef="t_pause" targetRef="t_beku" />
    <sequenceFlow id="f17" sourceRef="t_beku" targetRef="t_resume" />
    <sequenceFlow id="f18" sourceRef="t_resume" targetRef="t_lanjut" />
    <sequenceFlow id="f19" sourceRef="t_lanjut" targetRef="end" />
    <sequenceFlow id="f20" sourceRef="g_pause" targetRef="end" name="Tidak" />
  </process>
