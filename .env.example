# CBT SMK v2 — contoh konfigurasi.
# Salin ke .env lalu isi. .env JANGAN di-commit.
# Dipakai server (config.Load) + `make seed`.

# DSN PostgreSQL (WAJIB). Contoh lokal:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cbt_smk_v2?sslmode=disable

# Port HTTP server (default 9988).
PORT=9988

# Secret session (WAJIB di prod; di dev boleh kosong -> secret acak per proses).
# Bangkitkan dengan: openssl rand -hex 32
SESSION_SECRET=

# APP_ENV: dev | prod. Di prod, SESSION_SECRET wajib + cookie Secure aktif.
APP_ENV=dev

# Bootstrap admin awal via env (opsional; hanya bila tabel users kosong).
# Di produksi, pakai CLI: go run ./cmd/server create-admin ...
ADMIN_BOOTSTRAP=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
